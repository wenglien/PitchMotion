{
  "name": "mobile",
  "version": "1.0.0",
  "main": "src/entry/index.ts",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node --experimental-strip-types scripts/check-architecture.mjs",
    "check:functionality": "node scripts/check-functionality.mjs",
    "check:speed": "xcrun swiftc modules/expo-speedgun/ios/Types.swift modules/expo-speedgun/ios/Tracking/SORTTracker.swift modules/expo-speedgun/ios/Tracking/TrackSelection.swift modules/expo-speedgun/ios/Measurement/BallSpeedCalculator.swift scripts/check-speed-calculator.swift -o /tmp/speedgun-check-speed && /tmp/speedgun-check-speed",
    "check:release": "npm run typecheck && npm run check:architecture && npm run check:functionality && npm run check:speed && npx expo-doctor && expo export --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.31",
    "expo-camera": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-sharing": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.21",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
